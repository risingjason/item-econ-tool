---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestTftCdnVersion } from "../scripts/links.js";
import ItemSelector from "../components/ItemSelector.jsx";
import ComponentMinigame from "../components/ComponentMinigame.jsx";

const cdnVersion = await getLatestTftCdnVersion();
---

<BaseLayout pageTitle="TFT Item Economy Tool">
	<h1>Item Economy</h1>
	<h1>{cdnVersion}</h1>
	<ItemSelector cdnVersion={cdnVersion} client:only="react" />
	<ComponentMinigame client:only="react" />
</BaseLayout>
